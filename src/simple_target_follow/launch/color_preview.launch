<launch>
  <!-- Camera + perception only. No MAVROS, mode changes, or flight commands. -->
  <arg name="start_camera" default="true" />
  <arg name="realsense_serial" default="918512073667" />
  <arg name="image_topic" default="/camera/color/image_raw" />
  <arg name="config" default="$(find simple_target_follow)/config/color_target.yaml" />
  <arg name="color_width" default="640" />
  <arg name="color_height" default="480" />
  <arg name="color_fps" default="30" />
  <include if="$(arg start_camera)"
           file="$(find simple_target_follow)/launch/includes/color_camera.launch">
    <arg name="realsense_serial" value="$(arg realsense_serial)" />
    <arg name="color_width" value="$(arg color_width)" />
    <arg name="color_height" value="$(arg color_height)" />
    <arg name="color_fps" value="$(arg color_fps)" />
  </include>
  <node pkg="simple_target_follow" type="color_target_node.py" name="color_target" output="screen">
    <rosparam command="load" file="$(arg config)" />
    <param name="image_topic" value="$(arg image_topic)" />
  </node>
</launch>
